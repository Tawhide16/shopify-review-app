{
  "name": "reviewflow-shopify-app",
  "version": "1.0.0",
  "private": true,
  "description": "ReviewFlow - Complete Shopify Product Review App with Merchant Admin, Moderation, Theme App Extension and Anti-Spam",
  "type": "module",
  "scripts": {
    "start": "node app/server/server.js",
    "dev": "node app/server/server.js",
    "build": "npx prisma generate && npx prisma db push && npx vite build",
    "preview": "vite preview",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "setup": "node prisma/seed.js",
    "auto-push": "powershell -ExecutionPolicy Bypass -File ./auto_push.ps1"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "lucide-react": "^0.441.0",
    "prisma": "^5.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.3"
  }
}
