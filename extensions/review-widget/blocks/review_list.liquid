{% comment %}
  ReviewFlow Review List & Header Block
  Renders rating distribution, filter tabs, and approved reviews.
{% endcomment %}

<div 
  id="reviewflow-widget-section" 
  class="reviewflow-container"
  data-product-id="{{ product.id }}"
  data-shop="{{ shop.permanent_domain }}"
>
  <div class="reviewflow-header">
    <div class="reviewflow-summary-card">
      <div class="reviewflow-big-score" data-reviewflow-avg>5.0</div>
      <div class="reviewflow-stars large" data-reviewflow-stars-avg>
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <div class="reviewflow-total-text" data-reviewflow-total-reviews>Based on verified customer reviews</div>
    </div>

    <div class="reviewflow-histogram" id="reviewflow-histogram-bars">
      <!-- Generated dynamically by review-widget.js -->
    </div>

    <div class="reviewflow-cta-wrapper">
      <button 
        type="button" 
        class="reviewflow-btn reviewflow-btn-primary"
        onclick="ReviewFlow.openFormModal()"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        Write a Review
      </button>
    </div>
  </div>

  <div class="reviewflow-toolbar">
    <div class="reviewflow-filter-group">
      <label for="reviewflow-filter-rating">Filter by:</label>
      <select id="reviewflow-filter-rating" onchange="ReviewFlow.onFilterChange(this.value)">
        <option value="all">All Stars</option>
        <option value="5">5 Stars only</option>
        <option value="4">4 Stars only</option>
        <option value="3">3 Stars only</option>
        <option value="2">2 Stars only</option>
        <option value="1">1 Star only</option>
      </select>
    </div>

    <div class="reviewflow-sort-group">
      <label for="reviewflow-sort-by">Sort by:</label>
      <select id="reviewflow-sort-by" onchange="ReviewFlow.onSortChange(this.value)">
        <option value="newest">Most Recent</option>
        <option value="highest">Highest Rating</option>
        <option value="lowest">Lowest Rating</option>
        <option value="helpful">Most Helpful</option>
      </select>
    </div>
  </div>

  <div id="reviewflow-reviews-list" class="reviewflow-reviews-grid">
    <!-- Reviews inserted via review-widget.js -->
    <div class="reviewflow-loading-state">
      <div class="reviewflow-spinner"></div>
      <p>Loading genuine reviews...</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews List",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_verified_badge",
      "label": "Show Verified Buyer Badge",
      "default": true
    }
  ]
}
{% endschema %}
